# Build output
/build/
/build-*/
/build-root-check/

# IDE caches
CMakeSettings.json
CMakeUserPresets.json
.vs/
.vscode/

# Python (training scripts / venv)
/venv/
**/__pycache__/
*.pyc

# Large model files (tracked externally / via model downloader)
/models/
/WineFoxModel

# Third-party sources managed by git submodule or downloaded
# (submodule gitlinks must be tracked; contents are managed by each submodule's own .gitignore)
/tts-training/littlemaid_peco/
# CosyVoice: bundled model weights + python venv (re-download to populate)
/tts-training/colab-dataset-prepare/CosyVoice-0.5B/
# Generated TTS training dataset (wavs + logs, ~170MB)
/tts-training/jiuhu_tts_dataset_500/

# Pre-built llama.cpp binaries (kept outside source tree)
/llama-b10017-bin-win-cpu-x64/
/llama-b10017-bin-win-vulkan-x64/

# ---------------------------------------------------------------------------
# voice-test sandbox
# ---------------------------------------------------------------------------

# Build artifacts
/voice-test/build/

# ONNX / GGUF / .bin model weights — large, downloaded via scripts/
/voice-test/models/

# Pre-built ONNX Runtime binary (re-download via CMake fetch)
/voice-test/third_party/onnxruntime-prebuilt/

# Generated test artifacts (wav dumps, feature json, etc.)
/voice-test/*.wav
/voice-test/*.json
/voice-test/test-data/

# ---------------------------------------------------------------------------
# vulkan-test sandbox
# ---------------------------------------------------------------------------

# Build artifacts (also covered by /build-*/ at root)
/vulkan-test/build/

# ---------------------------------------------------------------------------
# tts-training (offline training workspace — keep scripts, ignore data/weights)
# ---------------------------------------------------------------------------

# Audio samples and generated datasets
/tts-training/**/*.wav
/tts-training/**/*.mp3
/tts-training/**/*.flac

# Model weights and binary artifacts
/tts-training/**/*.pt
/tts-training/**/*.pth
/tts-training/**/*.ckpt
/tts-training/**/*.safetensors
/tts-training/**/*.npy
/tts-training/**/*.pkl
/tts-training/**/*.bin

# Dataset manifests / large CSVs
/tts-training/**/manifest.jsonl
/tts-training/**/metadata.csv
/tts-training/**/routing_decisions.csv
/tts-training/**/audio_audit.json
/tts-training/**/needs_review.jsonl
/tts-training/**/stats.json
/tts-training/**/corpus.txt

# ---------------------------------------------------------------------------
# Runtime data
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
logs/
*.log
*.log.err
/winefox.json

# OS junk
Thumbs.db
.DS_Store
desktop.ini
