/tts-training/littlemaid_peco/

# Pre-built llama.cpp binaries (kept outside source tree)
/llama-b10017-bin-win-cpu-x64/
/llama.cpp-b10017-source/

# Runtime data
*.db
*.db-journal
*.db-wal
*.db-shm
logs/
*.log
*.log.err
winefox.json
# OS junk
Thumbs.db
.DS_Store
desktop.ini
